# ── Required ────────────────────────────────────────────────────────────────
# Your domain (A record -> this VPS). Free options: DuckDNS, a Cloudflare zone.
DOMAIN=sport.example.com
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# ── Stream list latency (defaults shown) ────────────────────────────────────
# Collect sibling sources this long after the first playable stream arrives.
# STREAM_FIRST_RESULT_GRACE_MS=1500
# Max wait for DaddyLive (priority-1) once other streams are ready.
# STREAM_PRIORITY_WAIT_MS=4000
# STREAM_SOFT_DEADLINE_MS=6000
# STREAM_HARD_DEADLINE_MS=15000
# Per-stream segment speed probe before answering (adds 1-5 s). Off by default.
# ENABLE_SPEED_PROBE=false

# ── Live playback ───────────────────────────────────────────────────────────
# Relay every video segment through this server (default true). Fixes ISP
# blocks of source CDNs, CDNs that demand browser headers, and plain-http
# segments. Costs ~3-8 Mbit/s of VPS traffic per viewer. false = direct CDN.
# PROXY_ALL_SEGMENTS=true
# Live playlist cache bounds (lower = closer to the live edge).
# LIVE_MANIFEST_TTL_MIN_MS=500
# LIVE_MANIFEST_TTL_MAX_MS=1000
# Serve the last good playlist on a transient upstream error for this long.
# MANIFEST_STALE_IF_ERROR_MS=12000
# MANIFEST_NEGATIVE_TTL_MS=4000
# MANIFEST_FETCH_TIMEOUT_MS=6000

# ── Load / stability ────────────────────────────────────────────────────────
# Max simultaneous extractor child processes (default: 2x CPU, 2..8).
# CHILD_PROC_MAX=4
# Full provider sync schedule and per-provider deadline.
# SYNC_CRON_SCHEDULE=*/30 * * * *
# PROVIDER_SYNC_TIMEOUT_MS=90000
# Low-RAM box (1 GB): fetch providers sequentially.
# LOW_MEMORY_MODE=true

# ── Optional: route DamiTV through Cloudflare WARP (socks5) ─────────────────
# WARP_PROXY_URL=socks5://127.0.0.1:40000

# ── Team crests (TheSportsDB) ────────────────────────────────────────────────
# Free test key is "123" (the old "3" key is disabled upstream). A premium key
# lifts the rate limit.
# THESPORTSDB_API_KEY=123
# THESPORTSDB_RPM=10

# ── Optional (from upstream) ────────────────────────────────────────────────
# ADDON_URL is set automatically from DOMAIN by docker-compose.yml.
# Residential proxy to get past Cloudflare: http://user:pass@host:port
RESIDENTIAL_PROXY=
# Cloudflare Worker proxy for edge scraping (CDNLive etc.)
CF_PROXY_URL=
# Vavoo 24/7 live TV channels (1,800+ channels). true / false
VAVOO_ENABLED=false
